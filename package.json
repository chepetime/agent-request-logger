{
  "name": "agent-request-logger",
  "version": "0.1.0",
  "description": "See the system prompts, tools, messages, and responses your coding agent sends over HTTP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-request-logger": "bin/agent-request-logger.js"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "docs/agents.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "pnpm build && node bin/agent-request-logger.js",
    "build": "node scripts/build.mjs",
    "start": "node bin/agent-request-logger.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run tests/e2e && node scripts/package-smoke.mjs",
    "test:package": "pnpm build && node scripts/package-smoke.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:compat": "pnpm build && tsx tests/compatibility/run.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chepetime/agent-request-logger.git"
  },
  "homepage": "https://github.com/chepetime/agent-request-logger#readme",
  "bugs": {
    "url": "https://github.com/chepetime/agent-request-logger/issues"
  },
  "packageManager": "pnpm@11.28.9"
}
